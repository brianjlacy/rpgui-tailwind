{
  "name": "rpgui-tailwind",
  "version": "0.0.1",
  "description": "A Tailwind CSS UI Kit with retro RPG-style components",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./css": "./dist/css/rpgui.css"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "keywords": [
    "rpg",
    "ui",
    "tailwind",
    "css",
    "components",
    "retro",
    "pixel-art",
    "gaming",
    "gui",
    "framework"
  ],
  "author": "Based on RPGUI by Ronen Ness",
  "license": "Zlib",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianjlacy/rpgui-tailwind.git"
  },
  "homepage": "https://github.com/brianjlacy/rpgui-tailwind",
  "bugs": {
    "url": "https://github.com/brianjlacy/rpgui-tailwind/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.14.2",
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
